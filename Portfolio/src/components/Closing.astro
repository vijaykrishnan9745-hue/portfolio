---
import site from '../content/site.json';
const { home = true } = Astro.props;
---
<div class="end">
  <div class="waves" data-waves aria-hidden="true"><canvas></canvas></div>
  <section id="contacts" class="contact" aria-labelledby="contacts-h">
    <h2 id="contacts-h" class="contact__title">{site.closingTitle}</h2>
    <p class="contact__sub">{site.closingSub}</p>
    <button type="button" class="mail" id="copy-email" data-email={site.email} data-magnet aria-label={`Copy email address ${site.email}`}>
      <span>{site.email}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h8"/></svg>
      <span class="mail__tip" aria-live="polite">Email copied</span>
    </button>
    <div class="social">
      {site.socials.map((s) => <a href={s.url} target="_blank" rel="noopener" aria-label={s.label}>{s.icon}</a>)}
    </div>
  </section>
  <footer class="foot">
    <span>© <span id="year">2026</span> {site.name}</span>
    <div><a href="#">Imprint</a><a href="#">Privacy policy</a></div>
  </footer>
  <div class="end__word" aria-hidden="true">{site.name}</div>
</div>
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Enlarged preview">
  <span class="lb-count" id="lb-count"></span>
  <button type="button" id="lb-close" aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
  <button type="button" class="lb-nav lb-prev" id="lb-prev" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg></button>
  <figure>
    <img id="lb-img" src="" alt="" />
    <figcaption id="lb-cap"></figcaption>
  </figure>
  <button type="button" class="lb-nav lb-next" id="lb-next" aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></button>
</div>
