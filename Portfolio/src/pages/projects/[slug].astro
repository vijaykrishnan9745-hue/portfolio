---
import { getCollection } from 'astro:content';
import { marked } from 'marked';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Closing from '../../components/Closing.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return all.map((p, i) => ({ params: { slug: p.id }, props: { p, next: all[(i + 1) % all.length] } }));
}
const { p, next } = Astro.props;
const d = p.data;

const esc = (s = '') => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const lines = (s = '') => esc(s).replace(/\n/g, '<br>');
const md = (s = '') => marked.parse(s, { async: false }) as string;
const pad = (n: number) => String(n + 1).padStart(2, '0');
const imgs = (b: any) => [].concat(b.images ?? []).filter(Boolean) as string[];
const caps = (b: any) => (b.captions ?? '').split('\n').map((c: string) => c.trim());
const heroTitle = d.heroTitle ?? d.title;
const meta = [['Year', d.year], ['Role', d.role], ['Scope', d.scope], ['Type', d.type], ['Client', d.client]];
const eyebrow = [d.tags, d.year].filter(Boolean).join(' · ');
---
<Base title={`${d.title}, case study`} description={d.summary}>
  <Header home={false} />
  <main id="main" class="cs" tabindex="-1">
    <div class="wrap">
      <a class="cs__back" href="/#works">← All work</a>
      <header class="cs__hero">
        <p class="cs__eyebrow">{eyebrow}</p>
        <h1 class="cs__title" set:html={lines(heroTitle)} />
        {d.lede && <p class="cs__lede">{d.lede}</p>}
      </header>
      <div class="cs__cover"><img src={d.cover} alt="" width="1200" height="750" /></div>
      <dl class="cs__meta">
        {meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>

      <div class="cs__body">
        <nav class="toc" aria-label="Sections" id="toc">
          <ol>
            {d.sections.map((s, i) => <li><a href={`#s-${i + 1}`}><span>{pad(i)}</span>{s.label}</a></li>)}
          </ol>
        </nav>
        <div class="cs__flow">
          {d.sections.map((s, i) => (
            <section class="sec" id={`s-${i + 1}`} data-sec>
              <p class="sec__num"><span>{pad(i)}</span>{s.label}</p>
              <h2 class="sec__h" set:html={lines(s.heading)} />
              {s.blocks.map((b) => {
                if (b.type === 'text') return <div class="prose" set:html={md(b.body)} />;
                if (b.type === 'subheading') return <h3 class="sec__sub">{b.text}</h3>;
                if (b.type === 'quote') return <blockquote class="pull"><p>{b.text}</p>{b.by && <cite>{b.by}</cite>}</blockquote>;
                if (b.type === 'list') return <ul class="bullets">{b.items.map((t) => <li>{t}</li>)}</ul>;
                if (b.type === 'stats') return (
                  <div class="stats">{b.items.map((st) => <div class="stat"><strong>{st.value}</strong><span>{st.label}</span></div>)}</div>
                );
                if (b.type === 'colors') return (
                  <ul class="swatches">{b.items.map((c) => <li><i style={`--c:${c.hex}`}></i><b>{c.name}</b><span>{c.hex}</span></li>)}</ul>
                );
                if (b.type === 'images') {
                  const list = imgs(b), cs = caps(b);
                  const figs = list.map((src, n) => (
                    <figure class="shot">
                      <button type="button" class="shot__btn" data-lb data-src={src} data-cap={cs[n] ?? ''} aria-label={`Enlarge image ${n + 1}`}>
                        <img src={src} alt={cs[n] ?? ''} loading="lazy" />
                      </button>
                      {cs[n] && <figcaption>{cs[n]}</figcaption>}
                    </figure>
                  ));
                  if (b.layout === 'carousel') return (
                    <div class="slider" data-slider>
                      <div class="slider__track">{figs}</div>
                      <div class="slider__ctl">
                        <button type="button" data-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 6-6 6 6 6"/></svg></button>
                        <button type="button" data-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg></button>
                      </div>
                    </div>
                  );
                  return <div class={`shots shots--${b.layout}`}>{figs}</div>;
                }
              })}
            </section>
          ))}
        </div>
      </div>

      <a class="next" href={`/projects/${next.id}`} data-cursor="Next project">
        <small>Next project</small>
        <strong>{next.data.title}</strong>
      </a>
    </div>
  </main>
  <Closing home={false} />
</Base>
